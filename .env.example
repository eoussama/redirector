# For `pnpm stats`. Copy to .env.stats (git-ignored) and fill in.
# Not .env: Wrangler loads .env as secrets for the local Worker, which would expose the
# token to it and break `wrangler types --check`. The variables are named apart from
# CLOUDFLARE_* for the same reason: Wrangler would pick those up as its own login.

# Cloudflare dashboard > Account home > the account's menu > Copy account ID.
STATS_ACCOUNT_ID=

# Cloudflare dashboard > My Profile > API Tokens > Create token, with the
# "Account Analytics: Read" permission only.
STATS_API_TOKEN=
