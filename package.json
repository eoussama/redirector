{
  "name": "redirector",
  "type": "module",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "description": "My link redirector, a Cloudflare Worker served at to.ouss.es.",
  "author": "eoussama",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "wrangler dev",
    "lint": "dx lint",
    "fix": "dx fix",
    "types": "wrangler types",
    "typecheck": "wrangler types --check && tsc --noEmit",
    "validate": "node scripts/validate-links.ts",
    "schema": "node scripts/schema.ts",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "stats": "node --env-file-if-exists=.env.stats scripts/stats.ts",
    "check": "pnpm install --frozen-lockfile && pnpm audit && pnpm lint && pnpm typecheck && pnpm validate && pnpm test && pnpm build"
  },
  "dependencies": {
    "@eoussama/core": "^0.1.2",
    "uqr": "^0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@eoussama/dx": "^0.1.3",
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.162.0"
  }
}
