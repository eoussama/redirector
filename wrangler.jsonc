{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "redirector",
  "main": "src/index.ts",
  // The newest date the test runtime (vitest-pool-workers) supports; raise it with that package.
  "compatibility_date": "2026-08-22",
  // Served only on the custom domain: no workers.dev or Preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "to.ouss.es", "custom_domain": true }
  ],
  // Click counts: slug, outcome, country and referrer host. Never an IP address.
  "analytics_engine_datasets": [
    { "binding": "CLICKS", "dataset": "redirector_clicks" }
  ],
  // Workers Logs and traces are on by default for new Workers, and would store each
  // request's metadata, IP headers included. Off on purpose.
  "observability": {
    "enabled": false,
    "logs": { "enabled": false },
    "traces": { "enabled": false }
  }
}
