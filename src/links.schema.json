{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Redirector links",
  "description": "The links served at to.ouss.es, keyed by slug.",
  "type": "object",
  "propertyNames": {
    "anyOf": [
      {
        "const": "$schema"
      },
      {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    ]
  },
  "additionalProperties": {
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https?:\\/\\/",
            "description": "The target, an absolute http or https URL."
          },
          "permanent": {
            "type": "boolean",
            "description": "Answer with 301 (cached by browsers) instead of 302."
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "mailto": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "description": "The recipient's address."
          },
          "subject": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "cc": {
            "anyOf": [
              {
                "type": "string",
                "format": "email",
                "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              },
              {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "email",
                  "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                }
              }
            ]
          },
          "bcc": {
            "anyOf": [
              {
                "type": "string",
                "format": "email",
                "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              },
              {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "email",
                  "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                }
              }
            ]
          }
        },
        "required": [
          "mailto"
        ],
        "additionalProperties": false
      }
    ]
  },
  "properties": {
    "$schema": {
      "type": "string"
    }
  }
}
